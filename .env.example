# Application
PORT=4000
FRONTEND_URL=http://localhost:3003
APP_URL=http://localhost:3003

# PostgreSQL
POSTGRES_DB=padel
POSTGRES_USER=padel
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgres://padel:change_me@postgres:5432/padel

# Frontend build
VITE_API_BASE_URL=/api

# JWT
JWT_SECRET=replace_with_a_long_random_secret

# Initial admin.
# Used only when the database has no users.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace_with_a_strong_password
INITIAL_ADMIN_NAME=Administrador

# Google OAuth
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# SMTP email.
# Local email/password registration requires these values.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Padel Torrelameu <no-reply@example.com>"

